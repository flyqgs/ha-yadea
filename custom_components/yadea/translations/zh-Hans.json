        "data": {
          "password": "密码"
        }
      },
      "reconfigure": {
        "title": "修改雅迪智行账号",
        "description": "重新登录并更新账号信息",
        "data": {
          "account": "手机号",
          "password": "密码"
        }
      }
    },
    "error": {
      "invalid_auth": "账号或密码错误（或该手机号未注册雅迪智行）",
