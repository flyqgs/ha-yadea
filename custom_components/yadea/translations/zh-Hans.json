{
  "config": {
    "step": {
      "user": {
        "title": "雅迪智行账号",
        "description": "输入雅迪智行 App 的手机号和密码（与 App 登录一致）。注意：雅迪单会话，登录会让手机 App 掉线一次。",
        "data": {
          "account": "手机号",
          "password": "密码"
        }
      },
